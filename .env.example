# Copy to .env (make setup does this). Never commit .env.
# Rule: a new env var = update this file in the same PR.

# --- Local development (make dev, local Supabase via CLI) ---
DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:54322/postgres
PORT=8000
CORS_ORIGINS=http://localhost:3333
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Hosted Supabase (staging + production only, set in Vercel / host env) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Runtime data sources (requests only, nothing stored, NFR-L2) ---
LONGDO_API_KEY=
GOOGLE_PLACES_API_KEY=

# --- Private storage holding raw snapshots the pipeline reads ---
RAW_STORAGE_URL=
RAW_STORAGE_TOKEN=

# Fetch/ingest keys (scrapers, bulk API pulls) do NOT belong here.
# They live in the private day-off-ingest repo.
